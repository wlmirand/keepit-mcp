# keepIT URL reachable from the MCP container
KEEPIT_URL=http://keepit:80
# Preferred: automatic login with email and password
KEEPIT_EMAIL=you@example.com
KEEPIT_PASSWORD=CHANGE_ME
# Optional alternative to credentials (requires manual renewal)
# KEEPIT_TOKEN=
# Separate bearer key used by MCP clients
MCP_API_KEY=REPLACE_WITH_A_STRONG_SECRET
MAX_MEDIA_BYTES=8388608
